{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GatewayDb": "Server=localhost;Database=ScubaGatewayDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Secret": "CHANGE-ME-IN-PRODUCTION-USE-ENV-VAR-MIN-32-CHARS!",
    "Issuer": "ScubaClubGateway",
    "Audience": "ScubaClubClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Gateway": {
    "SharedSecret": "CHANGE-ME-IN-PRODUCTION-USE-ENV-VAR"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4300" ]
  },
  "ReverseProxy": {
    "Routes": {
      "members-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/members/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/members/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "specialty-types-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/specialty-types/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/specialty-types/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "brevet-types-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/brevet-types/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/brevet-types/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "avatars-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/uploads/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "materiaal-types-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/materiaal-types/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/materiaal-types/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "materialen-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/materialen/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/materialen/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "leningen-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/leningen/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/leningen/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "berichten-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/berichten/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/berichten/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "berichten-root-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/api/berichten"
        },
        "Transforms": [
          { "PathPattern": "/berichten" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "berichten-hub-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/hubs/berichten/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/berichten/{**catch-all}" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "berichten-hub-root-route": {
        "ClusterId": "member-api-cluster",
        "Match": {
          "Path": "/hubs/berichten"
        },
        "Transforms": [
          { "PathPattern": "/hubs/berichten" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      }
    },
    "Clusters": {
      "member-api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5107/"
          }
        }
      }
    }
  }
}
